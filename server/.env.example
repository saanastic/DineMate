# DineMate AI FastAPI backend - local development defaults
# Copy to .env and adjust as needed

# SQLite works out of the box (no Docker/PostgreSQL required)
DATABASE_URL=sqlite:///./dinemate.db

# For PostgreSQL via Docker instead, use:
# DATABASE_URL=postgresql+psycopg2://dinemate:changeme@localhost:5432/dinemate

SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis is optional — the app falls back to in-memory cache if unavailable
REDIS_URL=redis://localhost:6379/0

TAX_RATE=0.08
MENU_CACHE_TTL=300

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

FRONTEND_URL=http://localhost:5173
RESTAURANT_NAME=DineMate

OPENAI_API_KEY=
FAISS_INDEX_PATH=./data/faiss_index
